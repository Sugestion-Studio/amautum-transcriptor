{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "identifier": "default",
  "description": "Capacidades del agente: ejecutar sidecar binaries de whisper-cli y ffmpeg, y actualizarse a sí mismo. El de diarización (sherpa-diarize) lo inyecta el CI cuando está disponible.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "whisper-cli",
          "sidecar": true,
          "args": true
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "updater:default"
  ]
}

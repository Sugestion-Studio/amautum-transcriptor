{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Amautum Transcriptor",
  "version": "0.1.1",
  "identifier": "com.amautum.transcriptor.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:17172",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Amautum Transcriptor",
        "width": 520,
        "height": 480,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:17173 ws://localhost:17173; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Amautum Transcriptor"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Transcripción local de audiencias con Whisper",
    "longDescription": "Agente que ejecuta Whisper.cpp localmente para transcribir audiencias y declaraciones. El audio nunca sale del equipo del estudio.",
    "externalBin": [
      "binaries/whisper-cli",
      "binaries/ffmpeg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "shell": {
      "open": "^https?://"
    }
  }
}
